rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'X5WFM4C88cecVqry3wr4luIIVAv1' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'softcrafta@gmail.com' ||
          request.auth.token.email == 'Softcrafta@gmail.com' ||
          request.auth.token.email.lower() == 'softcrafta@gmail.com'
        ))
      );
    }

    function isSuperOrDocAdmin() {
      return isAdmin() ||
        (isSignedIn() &&
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.uid == userId &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 254 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp) &&
             (!('photoURL' in data) || data.photoURL == null || data.photoURL == '' ||
              (data.photoURL is string && data.photoURL.size() <= 2048 && data.photoURL.matches('^https?://.*')));
    }

    function isValidPost(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.slug is string && data.slug.size() > 0 && data.slug.size() <= 200 &&
             data.content is string && data.content.size() > 0 &&
             !data.content.matches('(?is).*data:image/.*') &&
             data.category is string && data.category.size() <= 100 &&
             (data.status == 'draft' || data.status == 'published') &&
             (!('excerpt' in data) || (data.excerpt is string && data.excerpt.size() <= 1000)) &&
             (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 2000 &&
                                           !data.coverImage.matches('(?i)^data:image/.*'))) &&
             (!('tags' in data) || data.tags is list) &&
             (!('featured' in data) || data.featured is bool) &&
             (!('featuredOrder' in data) || data.featuredOrder is number) &&
             (!('views' in data) || data.views is number) &&
             (!('authorId' in data) || (data.authorId is string && data.authorId.size() <= 128)) &&
             (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 200)) &&
             (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100));
    }

    function isValidImageAsset(data) {
      return data.keys().hasOnly([
               'url', 'fileName', 'mimeType', 'width', 'height', 'articleId', 'alt', 'createdAt'
             ]) &&
             data.keys().hasAll(['url', 'fileName', 'mimeType', 'createdAt']) &&
             data.url is string && data.url.matches('^https://[^ ]+$') && data.url.size() <= 2048 &&
             data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 255 &&
             data.mimeType in ['image/webp', 'image/jpeg', 'image/png'] &&
             data.createdAt is timestamp &&
             (!('width' in data) || (data.width is int && data.width > 0 && data.width <= 10000)) &&
             (!('height' in data) || (data.height is int && data.height > 0 && data.height <= 10000)) &&
             (!('articleId' in data) || (data.articleId is string && data.articleId.size() <= 200)) &&
             (!('alt' in data) || (data.alt is string && data.alt.size() <= 500));
    }

    function isValidEpisodeSchedule(data) {
      return (!('calendarEnabled' in data) || data.calendarEnabled is bool) &&
             (!('episodeReleaseDate' in data) ||
              (data.episodeReleaseDate is string &&
               (data.episodeReleaseDate == '' || data.episodeReleaseDate.matches('^\\d{4}-\\d{2}-\\d{2}$')))) &&
             (!('episodeReleaseTime' in data) ||
              (data.episodeReleaseTime is string &&
               (data.episodeReleaseTime == '' || data.episodeReleaseTime.matches('^([01]\\d|2[0-3]):[0-5]\\d$')))) &&
             (!('episodeTimezone' in data) ||
              (data.episodeTimezone is string && data.episodeTimezone.size() <= 100)) &&
             (!('episodeReleaseStatus' in data) ||
              data.episodeReleaseStatus in ['Scheduled', 'Released', 'Delayed', 'Cancelled']) &&
             (!('episodeNumber' in data) || (data.episodeNumber is string && data.episodeNumber.size() <= 40)) &&
             (!('episodeTitle' in data) || (data.episodeTitle is string && data.episodeTitle.size() <= 200)) &&
             (!('episodeScheduleNotes' in data) ||
              (data.episodeScheduleNotes is string && data.episodeScheduleNotes.size() <= 1000)) &&
             (!('calendarEnabled' in data) || data.calendarEnabled != true ||
              (data.episodeReleaseDate is string &&
               data.episodeReleaseDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
               data.episodeTimezone is string && data.episodeTimezone.size() > 0 &&
               data.episodeReleaseStatus in ['Scheduled', 'Released', 'Delayed', 'Cancelled']));
    }

    function hasNoInlinePoster(data) {
      return !('poster' in data) ||
             data.poster == null ||
             (data.poster is string &&
              data.poster.size() <= 2048 &&
              !data.poster.matches('(?i)^data:image/.*'));
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId) || isSuperOrDocAdmin();
      allow create, update: if (isOwner(userId) || isSuperOrDocAdmin()) && isValidUserProfile(incoming(), userId);
      allow delete: if isOwner(userId) || isSuperOrDocAdmin();
    }

    match /users/{userId}/myList/{animeId} {
      allow get, list, create, update, delete: if isOwner(userId) || isSuperOrDocAdmin();
    }

    match /users/{userId}/favorites/{animeId} {
      allow get, list, create, update, delete: if isOwner(userId) || isSuperOrDocAdmin();
    }

    match /users/{userId}/recentlyViewed/{animeId} {
      allow get, list, create, update, delete: if isOwner(userId) || isSuperOrDocAdmin();
    }

    match /posts/{postId} {
      allow get: if (resource.data.status == 'published') ||
                    isSuperOrDocAdmin() ||
                    (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow list: if (resource.data.status == 'published') ||
                     isAdmin() ||
                     (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow create: if isValidPost(incoming()) &&
                       (isSuperOrDocAdmin() || (isSignedIn() && incoming().authorId == request.auth.uid));
      allow update: if (
                       (
                         (isSuperOrDocAdmin() ||
                          (isSignedIn() && resource.data.authorId == request.auth.uid)) &&
                         !incoming().diff(existing()).affectedKeys().hasAny(['views', 'lastViewedAt']) &&
                         isValidPost(incoming())
                       ) ||
                       (
                         !isSuperOrDocAdmin() &&
                         resource.data.status == 'published' &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['views', 'lastViewedAt']) &&
                         isValidPost(incoming()) &&
                         incoming().views is number &&
                         incoming().views >= 0 &&
                         incoming().views == existing().views + 1 &&
                         incoming().lastViewedAt is timestamp
                       )
                     );
      allow delete: if isSuperOrDocAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    match /posts/{postId}/viewers/{visitorId} {
      allow get: if true;
      allow create: if !isSuperOrDocAdmin() &&
                       visitorId.matches('^animoro_visitor_[a-f0-9]{32}$') &&
                       get(/databases/$(database)/documents/posts/$(postId)).data.status == 'published' &&
                       request.resource.data.keys().hasOnly(['viewedAt']) &&
                       request.resource.data.keys().hasAll(['viewedAt']) &&
                       request.resource.data.viewedAt == request.time;
      allow update: if !isSuperOrDocAdmin() &&
                       visitorId.matches('^animoro_visitor_[a-f0-9]{32}$') &&
                       get(/databases/$(database)/documents/posts/$(postId)).data.status == 'published' &&
                       resource.data.viewedAt is timestamp &&
                       request.time > resource.data.viewedAt + duration.value(1, 'd') &&
                       request.resource.data.keys().hasOnly(['viewedAt']) &&
                       request.resource.data.viewedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedAt']);
      allow delete: if isSuperOrDocAdmin();
    }

    match /anime/{animeId} {
      allow get, list: if resource.data.visibility == 'published' || isSuperOrDocAdmin();
      allow create, update: if isSuperOrDocAdmin() && isValidEpisodeSchedule(incoming());
      allow delete: if isSuperOrDocAdmin();
    }

    match /animeLists/{listId} {
      allow get, list, create, update, delete: if isSuperOrDocAdmin();

      match /members/{animeId} {
        allow get, list, create, update, delete: if isSuperOrDocAdmin();
      }
    }

    match /upcomingAnime/{animeId} {
      allow get, list: if (resource.data.status == 'published') || isSuperOrDocAdmin();
      allow create, update: if isSuperOrDocAdmin() && hasNoInlinePoster(incoming());
      allow delete: if isSuperOrDocAdmin();
    }

    match /imageAssets/{imageId} {
      allow get, list: if isSuperOrDocAdmin();
      allow create, update: if isSuperOrDocAdmin() && isValidImageAsset(incoming());
      allow delete: if isSuperOrDocAdmin();
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isSuperOrDocAdmin();
    }

    match /contacts/{contactId} {
      allow create: if incoming().keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt']) &&
                       incoming().keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt']) &&
                       incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100 &&
                       incoming().email is string && incoming().email.size() > 0 && incoming().email.size() <= 200 &&
                       incoming().subject in ['Editorial Tip', 'Review Request', 'Correction', 'Press / Business', 'Other'] &&
                       incoming().message is string && incoming().message.size() > 0 && incoming().message.size() <= 5000 &&
                       incoming().createdAt == request.time;
      allow get, list, update, delete: if isSuperOrDocAdmin();
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && (request.auth.uid == adminUid || isSuperOrDocAdmin());
      allow list: if isSuperOrDocAdmin();
      allow create, update: if isSuperOrDocAdmin();
      allow delete: if isSuperOrDocAdmin();
    }

    // Visitor analytics are written/read only through trusted server-side Admin SDK APIs.
    match /analytics_events/{eventId} {
      allow read, write: if false;
    }

    match /analytics_visitors/{visitorId} {
      allow read, write: if false;
    }

    match /analytics_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /analytics_rate_limits/{limitId} {
      allow read, write: if false;
    }

    match /analytics_daily_summaries/{dayId} {
      allow read, write: if false;

      match /visitors/{visitorId} {
        allow read, write: if false;
      }
    }
  }
}
