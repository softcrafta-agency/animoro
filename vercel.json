{
    "rewrites":  [
                     {
                         "source":  "/blog/:slug",
                         "destination":  "/api/article"
                     },
                     {
                         "source":  "/anime.html/:slug*",
                         "destination":  "/anime.html"
                     },
                     {
                         "source":  "/manhwa.html/:slug*",
                         "destination":  "/manhwa.html"
                     },
                     {
                         "source":  "/manhwa",
                         "destination":  "/manhwa.html"
                     },
                     {
                         "source":  "/manhwa/:slug*",
                         "destination":  "/manhwa.html"
                     },
                     {
                         "source":  "/anime/:slug*",
                         "destination":  "/anime.html"
                     },
                     {
                         "source":  "/anime-list",
                         "destination":  "/anime.html"
                     },
                     {
                         "source":  "/upcoming-anime",
                         "destination":  "/upcoming-anime.html"
                     },
                     {
                         "source":  "/upcoming-anime.html/:slug*",
                         "destination":  "/upcoming-anime.html"
                     },
                     {
                         "source":  "/upcoming-anime/:slug*",
                         "destination":  "/upcoming-anime.html"
                     },
                     {
                         "source":  "/my-list",
                         "destination":  "/my-list.html"
                     },
                     {
                         "source":  "/sitemap.xml",
                         "destination":  "/api/sitemap"
                     }
                 ],
    "functions":  {
                      "api/article.js":  {
                                             "includeFiles":  "dist/blog.html"
                                         }
                  },
    "redirects":  [
                      {
                          "source":  "/index.html",
                          "destination":  "/",
                          "statusCode":  308
                      },
                      {
                          "source":  "/blog.html/:slug",
                          "destination":  "/blog/:slug",
                          "statusCode":  308
                      },
                      {
                          "source":  "/anime.html",
                          "destination":  "/anime-list",
                          "statusCode":  301
                      },
                      {
                          "source":  "/manhwa.html",
                          "destination":  "/manhwa",
                          "statusCode":  301
                      },
                      {
                          "source":  "/manhwa.html/:slug*",
                          "destination":  "/manhwa/:slug*",
                          "statusCode":  301
                      },
                      {
                          "source":  "/anime",
                          "destination":  "/anime-list",
                          "statusCode":  308
                      },
                      {
                          "source":  "/anime.html/:slug*",
                          "destination":  "/anime/:slug*",
                          "statusCode":  301
                      },
                      {
                          "source":  "/upcoming-anime.html",
                          "destination":  "/upcoming-anime",
                          "statusCode":  301
                      },
                      {
                          "source":  "/upcoming-anime.html/:slug*",
                          "destination":  "/upcoming-anime/:slug*",
                          "statusCode":  301
                      }
                  ],
    "headers": [
        {
                          "source": "/festival-calendar.json",
                          "headers": [
                              {
                                  "key": "Cache-Control",
                                  "value": "public, max-age=300, stale-while-revalidate=86400"
                              }
                          ]
                      },
                      {
                          "source": "/assets/(.*)",
            "headers": [
                {
                     "key": "Cache-Control",
                     "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/logo.png",
            "headers": [
                {
                     "key": "Cache-Control",
                     "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/logo-small.webp",
            "headers": [
                {
                     "key": "Cache-Control",
                     "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/favicon.png",
            "headers": [
                {
                     "key": "Cache-Control",
                     "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/favicon-small.png",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/favicon.svg",
            "headers": [
                {
                     "key": "Cache-Control",
                     "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        }
    ]
}
