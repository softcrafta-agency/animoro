{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/blog/**",
        "destination": "/blog.html"
      },
      {
        "source": "/anime.html/**",
        "destination": "/anime.html"
      },
      {
        "source": "/upcoming-anime",
        "destination": "/upcoming-anime.html"
      },
      {
        "source": "/upcoming-anime.html/**",
        "destination": "/upcoming-anime.html"
      },
      {
        "source": "/upcoming-anime/**",
        "destination": "/upcoming-anime.html"
      },
      {
        "source": "/my-list",
        "destination": "/my-list.html"
      }
    ],
    "redirects": [
      {
        "source": "/blog.html/:slug",
        "destination": "/blog/:slug",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
