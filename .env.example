VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Vercel server-only variables. Never prefix R2 credentials with VITE_ or NEXT_PUBLIC_.
# Optional for the existing image deletion API; use the same bucket configured above.
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# Keep the following only for managing legacy Cloudflare R2 images and URLs.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=80e83f586721abc5cd846ecb3c851806
R2_BUCKET_NAME=animoro-images
# Preferred name; R2_PUBLIC_URL remains supported for existing Vercel deployments.
R2_PUBLIC_BASE_URL=
R2_PUBLIC_URL=https://pub-c4735d7299504d06aa8e1a5d749cfdbd.r2.dev

# Required by firebase-admin; store the service account JSON securely in Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Required by analytics ingestion for keyed, short-lived IP-based rate-limit identifiers.
# Set a unique random secret of at least 32 bytes in the server-side Vercel environment.
ANALYTICS_RATE_LIMIT_SECRET=

# Required for the server-only Groq SEO Copilot. Keep these out of VITE_* variables.
# Select a current production model from https://console.groq.com/docs/models.
GROQ_API_KEY=
GROQ_MODEL=
# Optional price-per-1M-token values for estimated usage reporting; leave blank if unknown.
GROQ_INPUT_COST_PER_MILLION=
GROQ_OUTPUT_COST_PER_MILLION=
# Maximum analyses per administrator in each 10-minute window.
SEO_COPILOT_RATE_LIMIT=20

# Optional, read-only Google Search Console integration.
# The service account needs access to the exact Search Console property in GSC_SITE_URL.
# Use a JSON service-account key stored only in the server-side deployment environment.
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=

# Vercel environment variables to add:
# VITE_FIREBASE_API_KEY
# VITE_FIREBASE_AUTH_DOMAIN
# VITE_FIREBASE_PROJECT_ID
# VITE_FIREBASE_STORAGE_BUCKET
# VITE_FIREBASE_MESSAGING_SENDER_ID
# VITE_FIREBASE_APP_ID
# FIREBASE_SERVICE_ACCOUNT_JSON
# GROQ_API_KEY
# GROQ_MODEL
