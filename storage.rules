rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    match /articles/{articleId}/images/{imageName} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        imageName in ['cover.webp', 'middle.webp', 'ending.webp'] &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType == 'image/webp';
      allow delete: if isAdmin();
    }
  }
}